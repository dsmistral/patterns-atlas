<text x="180" y="218" font-size="11.5" text-anchor="middle" fill="#555f6e">−5</text>
<line x1="320" y1="200" x2="320" y2="204" stroke="#555f6e" stroke-width="1.5"/>
<text x="320" y="218" font-size="11.5" text-anchor="middle" fill="#555f6e">3</text>
<polyline points="40,30 45,41.93 50,53.42 55,64.48 60,75.10 65,85.29 70,95.05 75,104.38 80,113.27 85,121.72 90,129.74 95,137.33 100,144.49 105,151.21 110,157.50 115,163.35 120,168.78 125,173.76 130,178.32 135,182.44 140,186.12 145,189.38 150,192.19 155,194.58 160,196.53 165,198.05 170,199.13 175,199.78 180,200 185,199.78 190,199.13 195,198.05 200,196.53 205,194.58 210,192.19 215,189.38 220,186.12 225,182.44 230,178.32 235,173.76 240,168.78 245,163.35 250,157.50 255,151.21 260,144.49 265,137.33 270,129.74 275,121.72 280,113.27 285,104.38 290,95.05 295,85.29 300,75.10 305,64.48 310,53.42 315,41.93 320,30" fill="none" stroke="#3574d4" stroke-width="2.4"/>
<circle cx="40" cy="30" r="3.2" fill="#c25b4a"/>
