<text x="260" y="34" font-size="11.5" text-anchor="end" fill="#555f6e">80</text>
<line x1="263.5" y1="200" x2="267.5" y2="200" stroke="#555f6e" stroke-width="1.5"/>
<text x="260" y="204" font-size="11.5" text-anchor="end" fill="#555f6e">16</text>
<line x1="40" y1="200" x2="40" y2="204" stroke="#555f6e" stroke-width="1.5"/>
<text x="40" y="218" font-size="11.5" text-anchor="middle" fill="#555f6e">−13</text>
